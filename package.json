{
  "id": "deki-tactility-integration",
  "displayName": "Tactility Integration",
  "minEngine": "0.17.0",
  "buildDefine": "DEKI_PACKAGE_TACTILITY",
  "platformRequires": [
    "tactility"
  ],
  "requires": [
    "deki-input"
  ],
  "features": [
